{
  "name": "@mietroyal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=development tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@mietroyal/config": "workspace:*",
    "@mietroyal/database": "workspace:*",
    "@mietroyal/permissions": "workspace:*",
    "@mietroyal/validation": "workspace:*",
    "@node-rs/argon2": "2.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "otpauth": "9.5.1",
    "pg": "8.23.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
