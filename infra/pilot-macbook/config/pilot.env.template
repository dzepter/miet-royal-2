# Miet-Royal Pilot (MacBook) – Konfiguration OHNE Secrets. Secrets stehen in secrets/pilot.secrets.env
# (configure-secrets.sh). Diese Datei wird von bootstrap.sh nach MR_BASE/config/pilot.env kopiert;
# Platzhalter __MR_BASE__ ersetzt bootstrap.sh durch das Basisverzeichnis.
# Umgebung des echten Piloten: production (Training-Gate, Fake-Verbot, https-Pflicht, Provider-Schalter).
APP_ENV=production
# API nur lokal; Caddy ist der einzige öffentliche Zugang (genau 1 Proxy-Hop ⇒ X-Forwarded-For vertrauen).
API_HOST=127.0.0.1
API_PORT=3001
API_TRUST_PROXY_HOPS=1
# Erlaubte Browser-Origins für Schreibzugriffe ohne Sec-Fetch-Site (ältere Browser/WebViews): genau die Pilot-Hosts
AUTH_ALLOWED_ORIGINS=https://staff-pilot.miet-royal.de,https://pilot.miet-royal.de
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=1000
# Dateispeicher lokal (Phase 19: S3 bleibt möglich – STORAGE_DRIVER=s3 + STORAGE_S3_* in secrets).
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=__MR_BASE__/storage
# Öffentliche Basis aller Kundenlinks (Angebote, Dokumente, Portal) UND SEO-Basis des Web – NUR der Pilot-Host.
MAIL_PUBLIC_WEB_BASE_URL=https://pilot.miet-royal.de
# Mail bleibt aus, bis das STRATO-Postfach eingerichtet ist (configure-secrets.sh setzt MAIL_ENABLED=true
# in pilot.env, sobald SMTP-Zugangsdaten vorliegen). STRATO: smtp.strato.de:465 (SSL/TLS), imap.strato.de:993.
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.strato.de
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_IMAP_ENABLED=false
MAIL_IMAP_HOST=imap.strato.de
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_IMAP_FOLDER=INBOX
MAIL_FROM_NAME=Miet-Royal
# MAIL_FROM_ADDRESS / MAIL_REPLY_ADDRESS setzt configure-secrets.sh (Postfachadresse, kein Secret).
# Buchhaltung: deaktiviert bis zur ausdrücklichen Freigabe (kein Key, kein Mock in production).
LEXWARE_ENABLED=false
# Routing: deaktiviert bis Vertragsprüfung (production erlaubt nur graphhopper oder disabled).
ROUTING_ENABLED=false
ROUTING_PROVIDER=disabled
# WhatsApp / Google Reviews: deaktiviert.
WHATSAPP_ENABLED=false
REVIEWS_PROVIDER=disabled
# Optional (kein Secret): Telefonnummer für den Anruf-Button im Portal, z. B. +49 6131 1234567.
# COMPANY_PHONE_NUMBER=
# NUR Web-/Staff-Server (Build UND Start mit denselben Werten):
WEB_APP_ENV=production
WEB_API_ORIGIN=http://127.0.0.1:3001
STAFF_API_ORIGIN=http://127.0.0.1:3001
WEB_PORT=3000
STAFF_PORT=3002
# WEB_INDEXING_ENABLED bleibt ungesetzt (= false): Pilot ist noindex, keine Sitemap, kein Canonical.
# ---- Kit-Einstellungen (kein Anwendungs-Env) ----
MR_PUBLIC_WEB_HOST=pilot.miet-royal.de
MR_PUBLIC_STAFF_HOST=staff-pilot.miet-royal.de
MR_PUBLIC_API_HOST=api-pilot.miet-royal.de
# ACME-Kontaktadresse für Let's Encrypt (Ablaufhinweise); keine Kundenadresse.
MR_ACME_EMAIL=
# Backup-Retention (nach realer Größe nachjustieren, s. Runbook).
MR_BACKUP_KEEP_DAILY=7
MR_BACKUP_KEEP_WEEKLY=4
# Warnschwellen freier Speicher in Prozent.
MR_DISK_WARN_PERCENT=20
MR_DISK_CRIT_PERCENT=10
# Git-Quelle für Releases.
MR_GIT_REMOTE=https://github.com/dzepter/miet-royal-2.git
