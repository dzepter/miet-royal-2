# Miet-Royal Pilot – SECRETS (Datei MR_BASE/secrets/pilot.secrets.env, Modus 600).
# NUR configure-secrets.sh schreibt diese Datei (Eingabe ohne Echo). Niemals committen, nie loggen.
# DATABASE_URL mit dem von setup-postgres.sh erzeugten Passwort (postgresql://mietroyal_pilot:<pw>@127.0.0.1:5432/mietroyal_pilot)
DATABASE_URL=
# Zufällige Schlüssel (>= 32 Zeichen), je Umgebung eigen – Teil jeder Sicherung.
AUTH_SECRET_KEY=
COMMUNICATION_PAYLOAD_KEY=
# STRATO-Postfach (erst wenn eingerichtet; MAIL_ENABLED in pilot.env dann true)
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
# Optional Web-Push (nur wenn für den Pilot benötigt): pnpm push:generate-vapid-keys
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=
