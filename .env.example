# Miet-Royal 2.0 – Referenzliste der Umgebungsvariablen
# (nur Namen, niemals echte Werte committen!)
#
# WICHTIG: Die Backend-Prozesse (API, Worker, Migrationen) lesen ausschließlich
# echte Umgebungsvariablen des Prozesses – eine .env-Datei wird von ihnen NICHT
# automatisch geladen (bewusste Entscheidung, siehe docs/TECH_DECISIONS.md).
#
# Lokale Entwicklung: keine Konfiguration nötig. Die Dev-Kommandos
# (pnpm dev, pnpm db:migrate:dev) setzen APP_ENV=development selbst, und nur
# in dieser Umgebung greifen sichere lokale Defaults (docs/ENVIRONMENTS.md).
#
# staging/demo/production: alle Werte Pflicht, als Secrets/Umgebungsvariablen
# auf dem Zielsystem gesetzt (z. B. systemd-Unit); fehlende Werte brechen den
# Start sofort ab. Der Isolations-Check (pnpm check:env-isolation a.env b.env)
# liest explizit übergebene env-Dateien dieses Formats.

# Umgebung: development | staging | demo | production
APP_ENV=

# Schlüssel (>= 32 Zeichen) zur Verschlüsselung von Auth-Geheimnissen im
# Ruhezustand (z. B. TOTP-Secrets). Je Umgebung ein EIGENER zufälliger Wert.
AUTH_SECRET_KEY=

# PostgreSQL-Verbindung (je Umgebung eine EIGENE Datenbank, niemals teilen)
DATABASE_URL=

# API
API_PORT=
API_HOST=
# Vertrauenswürdige Proxy-Hops vor der API (0 = keiner; hinter Staff-Proxy/nginx: 1)
API_TRUST_PROXY_HOPS=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=

# Worker
WORKER_POLL_INTERVAL_MS=

# Dateispeicher: fs (lokal) | s3 (S3-kompatibel, spätere Phase)
STORAGE_DRIVER=
STORAGE_FS_ROOT=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
