# Miet-Royal 2.0 – Umgebungsvariablen (nur Namen, niemals echte Werte committen!)
# Lokale Entwicklung funktioniert OHNE .env-Datei: sichere Development-Defaults
# greifen nur bei APP_ENV=development (siehe docs/ENVIRONMENTS.md).
# Für staging/demo/production sind alle Werte Pflicht und müssen als
# Secrets/Umgebungsvariablen auf dem Zielsystem gesetzt werden.

# Umgebung: development | staging | demo | production
APP_ENV=

# PostgreSQL-Verbindung (je Umgebung eine EIGENE Datenbank, niemals teilen)
DATABASE_URL=

# API
API_PORT=
API_HOST=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=

# Worker
WORKER_POLL_INTERVAL_MS=

# Dateispeicher: fs (lokal) | s3 (S3-kompatibel, spätere Phase)
STORAGE_DRIVER=
STORAGE_FS_ROOT=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
