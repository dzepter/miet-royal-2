# Miet-Royal 2.0 – Referenzliste der Umgebungsvariablen
# (nur Namen, niemals echte Werte committen!)
#
# WICHTIG: Die Backend-Prozesse (API, Worker, Migrationen) lesen ausschließlich
# echte Umgebungsvariablen des Prozesses – eine .env-Datei wird von ihnen NICHT
# automatisch geladen (bewusste Entscheidung, siehe docs/TECH_DECISIONS.md).
#
# Lokale Entwicklung: keine Konfiguration nötig. Die Dev-Kommandos
# (pnpm dev, pnpm db:migrate:dev) setzen APP_ENV=development selbst, und nur
# in dieser Umgebung greifen sichere lokale Defaults (docs/ENVIRONMENTS.md).
#
# staging/demo/production: alle Werte Pflicht, als Secrets/Umgebungsvariablen
# auf dem Zielsystem gesetzt (z. B. systemd-Unit); fehlende Werte brechen den
# Start sofort ab. Der Isolations-Check (pnpm check:env-isolation a.env b.env)
# liest explizit übergebene env-Dateien dieses Formats.

# Umgebung: development | staging | demo | production
APP_ENV=

# Schlüssel (>= 32 Zeichen) zur Verschlüsselung von Auth-Geheimnissen im
# Ruhezustand (z. B. TOTP-Secrets). Je Umgebung ein EIGENER zufälliger Wert.
AUTH_SECRET_KEY=

# NUR Staff-Server (next start), NICHT für API/Worker: öffentlicher Ed25519-
# Verifikationsschlüssel der Offline-Lease dieser Umgebung (kein Secret).
# Wert: `pnpm offline:lease-key` in der API-Umgebung. In staging/production
# PFLICHT (fail-closed: ohne Schlüssel akzeptiert die Staff-App keine Offline-
# Lease). Nach Rotation von AUTH_SECRET_KEY neu ausgeben. Nie ins Repo committen.
STAFF_OFFLINE_LEASE_VERIFICATION_KEY=

# PostgreSQL-Verbindung (je Umgebung eine EIGENE Datenbank, niemals teilen)
DATABASE_URL=

# API
API_PORT=
API_HOST=
# Vertrauenswürdige Proxy-Hops vor der API (0 = keiner; hinter Staff-Proxy/nginx: 1)
API_TRUST_PROXY_HOPS=

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=

# Worker
WORKER_POLL_INTERVAL_MS=

# Dateispeicher: fs (lokal) | s3 (S3-kompatibel, spätere Phase)
STORAGE_DRIVER=
STORAGE_FS_ROOT=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ── Phase 10: Lexware Office Public API (nur API/Worker, nie Staff/Web) ──
# API-Key aus app.lexware.de → Add-ons → Public API (Lebensdauer 24 Monate,
# Rotation siehe docs/DEPLOYMENT_NOTES.md). Nie ins Repo, nie in Logs/DB.
# production: gesetzt ⇒ Lexware aktiv (Host fest https://api.lexware.io);
# demo: NICHT setzen (Demo bucht niemals in Lexware);
# development/staging: nur zusammen mit LEXWARE_ENABLED=true (Opt-in).
LEXWARE_API_KEY=
LEXWARE_ENABLED=
# Nur außerhalb von production (lokaler Contract-Fake/Testaccount-Proxy);
# in production wird jeder andere Host als api.lexware.io abgelehnt.
LEXWARE_BASE_URL=
# Gepinnte organizationId des Lexware-Accounts (aus GET /v1/profile) –
# verhindert Buchungen in einen falschen Account.
LEXWARE_ORGANIZATION_ID=
# Öffentliche HTTPS-Callback-URL der API für Event-Subscriptions
# (z. B. https://api.<domain>/webhooks/lexware; gültiges Zertifikat Pflicht).
LEXWARE_WEBHOOK_CALLBACK_URL=
# Optional: Ersatz für den offiziellen Lexware-Webhook-Public-Key (PEM) –
# nur für Fake/Tests, in production leer lassen.
LEXWARE_WEBHOOK_PUBLIC_KEY_PEM=
# Optional: administrativ gesetztes Erinnerungsdatum der Key-Rotation (YYYY-MM-DD).
LEXWARE_API_KEY_REMINDER_DATE=
# Optional: HTTP-Timeout je Lexware-Aufruf in ms (Default 15000).
LEXWARE_REQUEST_TIMEOUT_MS=

# ── Phase 12 (mail): E-Mail-Versand/-Eingang und Kommunikations-Schlüssel ──
# (nur API/Worker, nie Staff/Web; Details docs/DEPLOYMENT_NOTES.md)
# true ⇒ SMTP-Versand aktiv (dann HOST/USER/PASSWORD/FROM_ADDRESS Pflicht);
# fehlt etwas, bleibt der Versand fail-closed deaktiviert (Zustellungen blocked).
MAIL_ENABLED=
MAIL_SMTP_HOST=
# Default 465 (implizites TLS) bzw. 587 (STARTTLS-Pflicht)
MAIL_SMTP_PORT=
# true = implizites TLS (465), false = STARTTLS-Pflicht (587); Klartext gibt es nicht.
MAIL_SMTP_SECURE=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# IMAP-Eingang: nur bei MAIL_IMAP_ENABLED=true aktiv (HOST/USER/PASSWORD dann Pflicht;
# fail-closed – gesetzte Zugangsdaten ohne Flag bleiben unbenutzt).
MAIL_IMAP_ENABLED=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_IMAP_SECURE=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_FOLDER=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
MAIL_REPLY_ADDRESS=
# NUR demo: kommagetrennte Empfänger (Adresse oder @domain); Pflicht bei MAIL_ENABLED=true.
MAIL_DEMO_WHITELIST=
# Absolute Basis-URL der öffentlichen Web-App für Angebots-/Dokument-/Kontaktlinks
# (production nur HTTPS; in staging/demo/production Pflicht bei MAIL_ENABLED=true),
# z. B. https://www.<domain>
MAIL_PUBLIC_WEB_BASE_URL=
# Schlüssel (>= 32 Zeichen) für AES-256-GCM-Payloads (Token, Gutscheincodes) –
# je Umgebung EIGEN, nie AUTH_SECRET_KEY wiederverwenden. PREVIOUS nur während
# einer Rotation (danach pnpm communication:rewrap-secrets, dann entfernen).
COMMUNICATION_PAYLOAD_KEY=
COMMUNICATION_PAYLOAD_KEY_PREVIOUS=

# ── Phase 12: Web Push für Mitarbeitende (VAPID, RFC 8292) ──────────────
# Alle drei Werte gemeinsam setzen (sonst Konfigurationsfehler); fehlen sie,
# ist Push deaktiviert (Server antwortet „nicht konfiguriert“). Erzeugen mit
# `pnpm --filter @mietroyal/api push:generate-vapid-keys` (oder
# `npx web-push generate-vapid-keys`) – je Umgebung ein eigenes Paar, der
# private Schlüssel bleibt serverseitig (nie Repo/Log/DB/Frontend).
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Kontakt des Betreibers für den Push-Dienst: mailto:… oder https://… (echte Adresse, Apple lehnt Platzhalter ab).
PUSH_VAPID_SUBJECT=

# ── Phase 12 (inbound): WhatsApp Business Cloud API (nur API/Worker, nie Staff/Web)
# Ausschließlich die offizielle Meta Cloud API (Graph API, verifiziert 2026-10-18;
# docs/COMMUNICATION_INTEGRATIONS.md). Alle fünf Werte gemeinsam mit
# WHATSAPP_ENABLED=true setzen ⇒ Modus „live“; sonst: production/staging
# „disabled“, development „mock“. demo ist IMMER „mock“ (simulierter Gateway,
# „DEMO / simuliert“) – gesetzte WHATSAPP_*-Werte sind dort ein Konfigurationsfehler.
WHATSAPP_ENABLED=
# System-User-Access-Token der Meta-App (nie Repo/Log/DB/Frontend; Rotation siehe Meta Business Manager)
WHATSAPP_ACCESS_TOKEN=
# Phone-Number-ID (numerisch) der Absendernummer
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp-Business-Account-ID (numerisch)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App-Secret der Meta-App: prüft X-Hub-Signature-256 jedes Webhook-POSTs (>= 16 Zeichen)
WHATSAPP_APP_SECRET=
# Frei gewähltes Geheimnis (>= 16 Zeichen) für die Webhook-Registrierung (GET hub.verify_token)
WHATSAPP_VERIFY_TOKEN=
# Optional: Graph-API-Version, Default v25.0 (Form vNN.N)
WHATSAPP_GRAPH_API_VERSION=
# Nur außerhalb von production (lokaler Fake); production erlaubt nur https://graph.facebook.com
WHATSAPP_BASE_URL=
